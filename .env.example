# Environment variables for different environments

# Development Environment
DEV_USERNAME=dev-user@example.com
DEV_PASSWORD=dev-password
DEV_API_KEY=dev-api-key
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_NAME=dev_database

# Staging Environment
STAGING_USERNAME=staging-user@example.com
STAGING_PASSWORD=staging-password
STAGING_API_KEY=staging-api-key
STAGING_DB_HOST=staging-db.example.com
STAGING_DB_PORT=5432
STAGING_DB_NAME=staging_database

# Production Environment (use actual values in production)
PROD_USERNAME=
PROD_PASSWORD=
PROD_API_KEY=
PROD_DB_HOST=
PROD_DB_PORT=5432
PROD_DB_NAME=

# Test Configuration
ENV=dev
DEBUG=false
CI=false