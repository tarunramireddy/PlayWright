# Environment variables for different environments
# 
# IMPORTANT: This is a template file. After cloning the repository:
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your actual values
# 3. Never commit .env to version control
#
# For team members: Get actual credential values from:
# - Your team lead or DevOps team
# - Company credential management system  
# - Testing environment documentation
# - GitHub repository secrets (for CI/CD reference)

# Environment selection (required)
ENV=dev

# Primary test user credentials (required for most tests)
TEST_USER_EMAIL=your-test-email@example.com
TEST_USER_PASSWORD=your-test-password

# Development Environment (optional)
DEV_USERNAME=dev-user@example.com
DEV_PASSWORD=dev-password
DEV_API_KEY=dev-api-key
DEV_DB_HOST=localhost
DEV_DB_PORT=5432
DEV_DB_NAME=dev_database

# Staging Environment (optional)
STAGING_USERNAME=staging-user@example.com
STAGING_PASSWORD=staging-password
STAGING_API_KEY=staging-api-key
STAGING_DB_HOST=staging-db.example.com
STAGING_DB_PORT=5432
STAGING_DB_NAME=staging_database

# Production Environment (use actual values in production)
PROD_USERNAME=
PROD_PASSWORD=
PROD_API_KEY=
PROD_DB_HOST=
PROD_DB_PORT=5432
PROD_DB_NAME=

# Test Configuration
DEBUG=false
CI=false