{
  "version": "1.0",
  "description": "Simple credentials configuration template - COPY THIS TO credentials.json",

  "environments": {
    "dev": {
      "description": "Local development environment",
      "baseUrl": "http://localhost:3000",
      "credentials": {
        "username": "your-dev-username@example.com",
        "password": "your-dev-password"
      }
    },

    "staging": {
      "description": "Staging testing environment",
      "baseUrl": "https://staging.yourcompany.com",
      "credentials": {
        "username": "your-staging-username@example.com",
        "password": "your-staging-password"
      }
    },

    "prod": {
      "description": "Production environment (use with caution)",
      "baseUrl": "https://yourcompany.com",
      "credentials": {
        "username": "your-prod-username@example.com",
        "password": "your-prod-password"
      }
    }
  },

  "testUsers": {
    "primary": {
      "description": "Main test user for most tests",
      "username": "your-primary-test-user@example.com",
      "password": "your-primary-test-password"
    },

    "admin": {
      "description": "Admin user for admin tests",
      "username": "your-admin-user@example.com",
      "password": "your-admin-password"
    },

    "guest": {
      "description": "Guest user for public access tests",
      "username": "guest@example.com",
      "password": "guest123"
    }
  }
}