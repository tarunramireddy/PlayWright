{
  "version": "1.0",
  "description": "Simple credentials configuration for Playwright tests",

  "environments": {
    "dev": {
      "description": "Local development environment",
      "baseUrl": "http://localhost:3000",
      "credentials": {
        "username": "dev-user@example.com",
        "password": "dev-password"
      }
    },

    "staging": {
      "description": "Staging testing environment",
      "baseUrl": "https://staging.example.com",
      "credentials": {
        "username": "staging-user@example.com",
        "password": "staging-password"
      }
    },

    "prod": {
      "description": "Production environment (use with caution)",
      "baseUrl": "https://example.com",
      "credentials": {
        "username": "prod-user@example.com",
        "password": "prod-password"
      }
    }
  },

  "testUsers": {
    "superAdmin": {
      "description": "Super admin user",
      "username": "ramirety@mail.uc.edu",
      "password": "password"
    },

    "allianceAdmin": {
      "description": "Admin user for admin tests",
      "username": "admin@company.com",
      "password": "admin123"
    },

    "leaAdmin": {
      "description": "Guest user for public access tests",
      "username": "guest@example.com",
      "password": "guest123"
    }
  }
